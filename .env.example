# ==============================================================================
# UrbanPulse – Hyderabad Smart City Geospatial Intelligence
# AWS Configuration Template
# ==============================================================================

# Amazon Location Service Configuration
# Default region for Hyderabad, Telangana is ap-south-1 (Asia Pacific - Mumbai)
VITE_AWS_REGION=ap-south-1

# Amazon Location Map Resource Name created in AWS Console or CloudFormation
VITE_AWS_LOCATION_MAP_NAME=UrbanPulseHyderabadMap

# Amazon Location Service API Key (Must allow geo:GetMap* action on the map resource)
# Example: v1.public.eyJ...
VITE_AWS_LOCATION_API_KEY=

# Amazon S3 GeoJSON Data Lake Endpoint
# S3 Bucket URL hosting partitioned GeoJSON datasets with CORS enabled
# Example: https://urbanpulse-hyderabad-geodata.s3.ap-south-1.amazonaws.com
VITE_AWS_S3_BUCKET_URL=

# S3 dataset path relative to bucket root
VITE_AWS_S3_DATASET_PATH=datasets/hyderabad_infrastructure.geojson

